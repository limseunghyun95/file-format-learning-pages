<h3 style="font-size:18px;color:#126246;">7.2 싼 증거부터 수집</h3>
<div style="background:#15211c;color:#e8f5ef;padding:15px;margin:12px 0;font-family:ui-monospace,SFMono-Regular,Menlo,monospace;font-size:14px;white-space:pre-wrap;overflow-wrap:anywhere;"><code>for f in /tmp/file-format-day07/*.parquet; do
  echo "=== $f ==="
  wc -c "$f"
  echo "head"
  xxd -g 1 -l 16 "$f"
  echo "tail"
  tail -c 16 "$f" | xxd -g 1
